
from nicegui import ui

from ml.targets.registry import (
    REGRESSION_TARGETS,
    BINARY_CLASSIFICATION_TARGETS,
    CATEGORICAL_TARGETS,
    DAILY_HORIZONS,
    PERIOD_HORIZONS,
    get_registry_summary,
    get_target_task,
    validate_target_registry,
)


# ==========================================================
# TARGETS PAGE
# ==========================================================

def targets_page():
    """Display the project's registered machine-learning targets."""

    # ------------------------------------------------------
    # Read target registry
    # ------------------------------------------------------

    registry_valid = validate_target_registry()
    summary = get_registry_summary()

    target_names = sorted(
        REGRESSION_TARGETS
        | BINARY_CLASSIFICATION_TARGETS
        | CATEGORICAL_TARGETS
    )

    task_labels = {
        'regression': 'Regression',
        'classification': 'Classification',
        'categorical': 'Categorical',
    }

    horizon_names = list(DAILY_HORIZONS) + list(PERIOD_HORIZONS)

    horizon_labels = {
        **{
            name: f'{name} — Day {day}'
            for name, day in DAILY_HORIZONS.items()
        },
        '8_15D': '8_15D — Days 8–15',
        '16_30D': '16_30D — Days 16–30',
        '30D': '30D — Days 1–30',
    }

    rows = []

    for target_name in target_names:
        parts = target_name.rsplit('_', 1)

        # Daily horizons end in names such as _1D.
        # Period horizons can contain an underscore,
        # so identify the complete suffix explicitly.
        matched_horizon = next(
            (
                horizon
                for horizon in sorted(
                    horizon_names,
                    key=len,
                    reverse=True,
                )
                if target_name.endswith(f'_{horizon}')
            ),
            None,
        )

        if matched_horizon is None:
            family = target_name
        else:
            family = target_name[
                :-(len(matched_horizon) + 1)
            ]

        task = get_target_task(target_name)

        rows.append({
            'name': target_name,
            'family': family,
            'task': task,
            'task_label': task_labels.get(task, task),
            'horizon': matched_horizon or 'Unknown',
            'horizon_label': horizon_labels.get(
                matched_horizon,
                'Unknown',
            ),
        })

    # ------------------------------------------------------
    # Page heading
    # ------------------------------------------------------

    ui.label('Targets').classes(
        'text-3xl font-bold'
    )

    ui.label(
        'Registered prediction targets generated by the '
        'machine-learning target registry.'
    ).classes('text-gray-500')

    if registry_valid:
        ui.label(
            'Registry validation passed'
        ).classes(
            'text-sm text-green-700 '
            'bg-green-50 rounded px-3 py-2'
        )
    else:
        ui.label(
            'Warning: target registry validation failed.'
        ).classes(
            'text-sm text-red-700 '
            'bg-red-50 rounded px-3 py-2'
        )

    # ------------------------------------------------------
    # Summary cards
    # ------------------------------------------------------

    with ui.grid(columns=4).classes('w-full gap-4'):

        with ui.card().classes('w-full'):
            ui.label('Total Targets').classes('text-gray-500')
            ui.label(
                str(summary['total_targets'])
            ).classes('text-3xl font-bold')

        with ui.card().classes('w-full'):
            ui.label('Regression').classes('text-gray-500')
            ui.label(
                str(summary['regression_targets'])
            ).classes('text-3xl font-bold text-blue-700')

        with ui.card().classes('w-full'):
            ui.label('Classification').classes('text-gray-500')
            ui.label(
                str(summary['classification_targets'])
            ).classes('text-3xl font-bold text-purple-700')

        with ui.card().classes('w-full'):
            ui.label('Categorical').classes('text-gray-500')
            ui.label(
                str(summary['categorical_targets'])
            ).classes('text-3xl font-bold text-orange-700')

    # ------------------------------------------------------
    # Horizon summary
    # ------------------------------------------------------

    with ui.card().classes('w-full'):
        ui.label('Prediction Horizons').classes(
            'text-xl font-semibold'
        )

        with ui.row().classes('w-full gap-8'):

            with ui.column().classes('gap-1'):
                ui.label('Daily horizons').classes('text-gray-500')
                ui.label(
                    str(len(DAILY_HORIZONS))
                ).classes('text-2xl font-bold')
                ui.label(
                    ', '.join(DAILY_HORIZONS.keys())
                ).classes('text-sm')

            with ui.column().classes('gap-1'):
                ui.label('Period horizons').classes('text-gray-500')
                ui.label(
                    str(len(PERIOD_HORIZONS))
                ).classes('text-2xl font-bold')
                ui.label(
                    ', '.join(PERIOD_HORIZONS.keys())
                ).classes('text-sm')

    # ------------------------------------------------------
    # Filters
    # ------------------------------------------------------

    ui.label('Explore Targets').classes(
        'text-xl font-semibold mt-4'
    )

    with ui.row().classes('w-full items-end gap-4'):

        search_input = ui.input(
            label='Search target or family',
            placeholder='e.g. Expense, Health, Activity',
        ).classes('grow')

        task_filter = ui.select(
            options={
                'all': 'All task types',
                'regression': 'Regression',
                'classification': 'Classification',
                'categorical': 'Categorical',
            },
            value='all',
            label='Task type',
        ).classes('w-56')

        horizon_options = {
            'all': 'All horizons',
            **{
                name: horizon_labels[name]
                for name in horizon_names
            },
        }

        horizon_filter = ui.select(
            options=horizon_options,
            value='all',
            label='Prediction horizon',
        ).classes('w-64')

    result_label = ui.label().classes('text-gray-500')

    # ------------------------------------------------------
    # Targets table
    # ------------------------------------------------------

    table = ui.table(
        columns=[
            {
                'name': 'name',
                'label': 'Target Name',
                'field': 'name',
                'align': 'left',
                'sortable': True,
            },
            {
                'name': 'family',
                'label': 'Target Family',
                'field': 'family',
                'align': 'left',
                'sortable': True,
            },
            {
                'name': 'task_label',
                'label': 'Task Type',
                'field': 'task_label',
                'align': 'left',
                'sortable': True,
            },
            {
                'name': 'horizon_label',
                'label': 'Horizon',
                'field': 'horizon_label',
                'align': 'left',
                'sortable': True,
            },
        ],
        rows=[],
        row_key='name',
        pagination={
            'rowsPerPage': 20,
            'sortBy': 'name',
            'descending': False,
        },
    ).classes('w-full')

    # ------------------------------------------------------
    # Filtering
    # ------------------------------------------------------

    def refresh_table():
        search_text = (
            search_input.value or ''
        ).strip().lower()

        selected_task = task_filter.value or 'all'
        selected_horizon = horizon_filter.value or 'all'

        filtered_rows = []

        for row in rows:

            if selected_task != 'all':
                if row['task'] != selected_task:
                    continue

            if selected_horizon != 'all':
                if row['horizon'] != selected_horizon:
                    continue

            if search_text:
                searchable_text = (
                    row['name'] + ' '
                    + row['family'] + ' '
                    + row['task_label'] + ' '
                    + row['horizon_label']
                ).lower()

                if search_text not in searchable_text:
                    continue

            filtered_rows.append(row)

        table.rows = filtered_rows
        table.update()

        result_label.text = (
            f'Showing {len(filtered_rows)} of {len(rows)} targets'
        )

    search_input.on_value_change(
        lambda _: refresh_table()
    )

    task_filter.on_value_change(
        lambda _: refresh_table()
    )

    horizon_filter.on_value_change(
        lambda _: refresh_table()
    )

    refresh_table()

    # ------------------------------------------------------
    # Notes
    # ------------------------------------------------------

    with ui.card().classes('w-full mt-4'):
        ui.label('About this page').classes(
            'text-lg font-semibold'
        )

        ui.label(
            'This page lists target definitions registered by '
            'the target builder. It does not imply that a model '
            'has been trained for every target.'
        ).classes('text-gray-600')

        ui.label(
            'The 30D horizon represents days 1–30. The 8_15D '
            'and 16_30D horizons represent days 8–15 and 16–30.'
        ).classes('text-gray-600')
